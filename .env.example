# Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=workout_bot
POSTGRES_USER=workout_user
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql+asyncpg://workout_user:strong_password_here@postgres:5432/workout_bot

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=workout-bot-media
S3_PUBLIC_URL=http://localhost:9000/workout-bot-media

# Sentry (optional)
SENTRY_DSN=

# App
APP_ENV=production
LOG_LEVEL=INFO
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/webhook
API_SECRET=your_api_secret_here
